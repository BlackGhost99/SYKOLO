# Development only. Set in your shell or use Docker Compose; Django does not load .env automatically.
APP_ENV=development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=sykolo-development-only
# DATABASE_URL=postgres://sykolo_dev:sykolo-development-only@localhost:5432/sykolo_dev
# DJANGO_SECRET_KEY=generate-a-unique-random-value-of-at-least-50-characters

# Cle MFA separee de DJANGO_SECRET_KEY (au moins 32 caracteres)
MFA_ENCRYPTION_KEY=dev-only-mfa-encryption-key-change-this-before-deploying-12345
# Liens de recuperation de mot de passe et relais SMTP en deploiement
AUTH_PUBLIC_BASE_URL=http://localhost:3000
# YEM_SMTP_HOST=
# YEM_SMTP_PORT=587
# YEM_SMTP_USER=
# YEM_SMTP_PASSWORD=
# YEM_FROM_EMAIL=
